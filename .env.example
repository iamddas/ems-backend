# Supabase Postgres connection
# Get these from Supabase dashboard -> Project Settings -> Database -> Connection string
# Use the "Session pooler" (port 5432), NOT "Transaction pooler" (port 6543) — Hibernate needs
# a persistent session for prepared statements, which transaction-mode pgbouncer breaks.
DB_URL=jdbc:postgresql://<project-ref>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-db-password>q

JWT_SECRET=<generate-with: openssl rand -hex 32>
JWT_EXPIRATION=86400000
SERVER_PORT=8080
